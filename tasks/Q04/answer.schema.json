    "affected_rows",
    "amount_usd",
    "evidence_ids"
   ],
   "type": "object"
  },
  "Metric": {
   "additionalProperties": false,
   "properties": {
    "evidence_ids": {
     "items": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 30,
     "type": "array"
    },
    "name": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "period": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "population": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "unit": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "name",
    "value",
    "unit",
    "population",
    "period",
    "evidence_ids"
   ],
   "type": "object"
  }
 },
 "$id": "https://analyst-bench.invalid/schemas/Q04.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "answered",
       "partial"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "result": {
      "not": {
       "type": "null"
      }
     }
    }
   }
  }
 ],
 "properties": {
  "assumptions": {
   "items": {
    "maxLength": 400,
    "minLength": 1,
    "type": "string"
   },
   "maxItems": 15,
   "type": "array"
  },
  "claims": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "evidence_ids": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "stance": {
      "enum": [
       "asserted",
       "qualified",
       "hypothesis"
      ]
     },
     "text": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "id",
     "text",
     "stance",
     "evidence_ids"
    ],
    "type": "object"
   },
   "maxItems": 20,
   "type": "array"
  },
  "evidence": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "minLength": 1,
      "type": "string"
     },
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "locator": {
      "minLength": 1,
      "type": "string"
     },
     "path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\x00]+$",
      "type": "string"
     }
    },
    "required": [
     "id",
     "path",
     "locator",
     "description"
    ],
    "type": "object"
   },
   "maxItems": 30,
   "type": "array"
  },
  "result": {
   "anyOf": [
    {
     "additionalProperties": false,
     "properties": {
      "rows": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "eligible": {
          "type": "integer"
         },
         "platform": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
         },
         "retained": {
          "type": "integer"
         },
         "retention": {
          "type": "number"
         }
        },
        "required": [
         "platform",
         "eligible",
         "retained",
         "retention"
        ],
        "type": "object"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      }
     },
     "required": [
      "rows"
     ],
     "type": "object"
    },
    {
     "type": "null"
    }
   ]
  },
  "schema_version": {
   "const": "1.1"
  },
  "status": {
   "enum": [
    "answered",
    "partial",
    "not_identifiable"
   ]
  },
  "task_id": {
   "const": "Q04"
  },
  "warnings": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "claim_ids": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "consequence": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "result_paths": {
      "items": {
       "format": "json-pointer",
       "pattern": "^/result(/.*)?$",
       "type": "string"
      },
      "type": "array"
     },
     "text": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "claim_ids",
     "result_paths",
     "text",
     "consequence"
    ],
    "type": "object"
   },
   "maxItems": 20,
   "type": "array"
  }
 },
 "required": [
  "schema_version",
  "task_id",
  "status",
  "result",
  "claims",
  "warnings",
  "assumptions",
  "evidence"
 ],
 "title": "Q04 answer",
 "type": "object"
}
