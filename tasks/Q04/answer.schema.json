     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "metrics",
    "findings",
    "transformation_path"
   ],
   "type": "object"
  },
  "BusinessResult": {
   "additionalProperties": false,
   "properties": {
    "actions": {
     "items": {
      "$ref": "#/$defs/Action"
     },
     "maxItems": 5,
     "type": "array"
    },
    "metrics": {
     "items": {
      "$ref": "#/$defs/Metric"
     },
     "maxItems": 200,
     "type": "array"
    },
    "missing_information": {
     "items": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 30,
     "type": "array"
    },
    "recommendation": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "metrics",
    "recommendation",
    "actions",
    "missing_information"
   ],
   "type": "object"
  },
  "Check": {
   "additionalProperties": false,
   "properties": {
    "evidence_ids": {
     "items": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 30,
     "type": "array"
    },
    "name": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "p_value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "passed": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ]
    },
    "statistic": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "name",
    "statistic",
    "p_value",
    "passed",
    "evidence_ids"
   ],
   "type": "object"
  },
  "DiagnosisResult": {
   "additionalProperties": false,
   "properties": {
    "conclusion": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "drivers": {
     "items": {
      "$ref": "#/$defs/Driver"
     },
     "maxItems": 30,
     "type": "array"
    },
    "metrics": {
     "items": {
      "$ref": "#/$defs/Metric"
     },
     "maxItems": 200,
     "type": "array"
    }
   },
   "required": [
    "metrics",
    "drivers",
    "conclusion"
   ],
   "type": "object"
  },
  "Driver": {
   "additionalProperties": false,
   "properties": {
    "contribution": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "description": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "evidence_ids": {
     "items": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 30,
     "type": "array"
    },
    "outcome": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "unit": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "description",
    "outcome",
    "contribution",
    "unit",
    "evidence_ids"
   ],
   "type": "object"
  },
  "EstimateResult": {
   "additionalProperties": false,
   "properties": {
    "conclusion": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "method": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "metrics": {
     "items": {
      "$ref": "#/$defs/Metric"
     },
     "maxItems": 200,
     "type": "array"
    }
   },
   "required": [
    "metrics",
    "method",
    "conclusion"
   ],
   "type": "object"
  },
  "ExperimentResult": {
   "additionalProperties": false,
   "properties": {
    "checks": {
     "items": {
      "$ref": "#/$defs/Check"
     },
     "maxItems": 30,
     "type": "array"
    },
    "decision": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "metrics": {
     "items": {
      "$ref": "#/$defs/Metric"
     },
     "maxItems": 200,
     "type": "array"
    },
    "rationale": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "metrics",
    "checks",
    "decision",
    "rationale"
   ],
   "type": "object"
  },
  "Finding": {
   "additionalProperties": false,
   "properties": {
    "affected_rows": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "amount_usd": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "evidence_ids": {
     "items": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 30,
     "type": "array"
    },
