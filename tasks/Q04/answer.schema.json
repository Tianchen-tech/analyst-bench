     "minimum": 1,
     "type": "integer"
    },
    "rationale": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "stop_condition": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "success_metric": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "priority",
    "action",
    "rationale",
    "success_metric",
    "stop_condition"
   ],
   "type": "object"
  },
  "AuditResult": {
   "additionalProperties": false,
   "properties": {
    "findings": {
     "items": {
